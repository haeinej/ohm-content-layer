{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "cortex hook session-start --agent claude-code", "timeout": 5 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "cortex hook prompt --agent claude-code", "timeout": 5 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "cortex hook stop --agent claude-code", "timeout": 5 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "cortex hook session-end --agent claude-code", "timeout": 3 }] }
    ]
  }
}
