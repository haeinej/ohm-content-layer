# Policy for a cortex kept in git. Agents do not edit this file.

# A version is worked out from a file's exact text, so line endings are the same on every machine.
* text=auto eol=lf

# The index is generated, and is rebuilt at the start of every session.
memory/MEMORY.md linguist-generated merge=union

# Notes are only ever added to, one line each, so two machines' lines are both kept.
.cortex/notes.jsonl merge=union

# Nothing in secrets is shown in a diff, should a file there ever be added by force.
agents/secrets/** -diff

# Identity changes are only ever added to, one line each, so two machines' lines are both kept.
.cortex/identity.jsonl merge=union

# Session starts, asks and distills are only ever added to, one line each.
.cortex/sessions.jsonl merge=union
